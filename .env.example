# Contact address sent with Crossref and OpenAlex requests (polite pool).
# Use an email you actually read. The default placeholder still works,
# but Crossref may throttle unidentified clients.
VERIFAI_MAILTO=you@example.com

# Optional. Without a key, OpenAlex shares a small free daily budget per IP.
# VERIFAI_OPENALEX_API_KEY=

# Optional. Semantic Scholar is not called unless this is set.
# VERIFAI_SEMANTIC_SCHOLAR_API_KEY=

VERIFAI_HOST=127.0.0.1
VERIFAI_PORT=8741
