# Contact address sent with Crossref and OpenAlex requests (polite pool).
# Use an email you actually read. The default placeholder still works,
# but Crossref may throttle unidentified clients.
VERIFAI_MAILTO=you@example.com

# Optional. Without a key, OpenAlex shares a small free daily budget per IP.
# VERIFAI_OPENALEX_API_KEY=

# Optional. Semantic Scholar is not called unless this is set.
# VERIFAI_SEMANTIC_SCHOLAR_API_KEY=

# Optional. Google Fact Check reviews are not requested unless this is set.
# They still count as one source, never as the only source of a verdict.
# VERIFAI_GOOGLE_FACTCHECK_API_KEY=

# Local model. auto uses a small NLI model when installed, otherwise MLX on
# Apple silicon, otherwise Ollama, otherwise llama.cpp. none skips judging.
# VERIFAI_MODEL_BACKEND=auto
# VERIFAI_MLX_MODEL=mlx-community/Qwen3.5-9B-4bit
# VERIFAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# VERIFAI_OLLAMA_MODEL=qwen3.5:9b
# VERIFAI_LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# VERIFAI_LLAMACPP_MODEL=qwen3.5-9b
# VERIFAI_NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
# VERIFAI_NLI_ENABLED=true

VERIFAI_HOST=127.0.0.1
VERIFAI_PORT=8741

# Public deployments. 0 turns a limit off, which suits a local install.
# Counted per client address, in this process only. See docs/deploy.md.
# VERIFAI_RATE_LIMIT_PER_MINUTE=0
# VERIFAI_RATE_LIMIT_PER_HOUR=0
# Checks that run at once. Others wait this many seconds, then get a 503.
# VERIFAI_MAX_CONCURRENT_CHECKS=4
# VERIFAI_CHECK_QUEUE_SECONDS=20
# Proxies whose X-Forwarded-For is trusted. Same-machine Caddy, nginx, or
# cloudflared need no change. Use the proxy's address if it runs elsewhere.
# VERIFAI_FORWARDED_ALLOW_IPS=127.0.0.1

# Seconds to wait for a response body. Connecting still gives up after 5 seconds.
# VERIFAI_HTTP_TIMEOUT=20

# Extra attempts after a timeout, HTTP 429, or HTTP 5xx. Capped at 8.
# VERIFAI_HTTP_RETRIES=1

# Minimum gap between requests to the same host. 0 disables the wait.
# VERIFAI_HTTP_MIN_INTERVAL_SECONDS=0.2

# Largest response body kept. Anything larger is treated as unavailable.
# VERIFAI_HTTP_MAX_RESPONSE_BYTES=2000000

# Character cap for one paste, and the point where a request body is refused.
# VERIFAI_MAX_TEXT_CHARS=50000
